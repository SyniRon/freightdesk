{
  "name": "freightdesk-web",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prebuild": "((test -f public/items.json && test -f public/locations.json) || pnpm build:sde) && pnpm build:services",
    "preview": "vite preview --host",
    "build:sde": "tsx scripts/build-sde.ts",
    "build:services": "tsx scripts/build-services.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cd ../e2e && pnpm exec playwright test"
  },
  "dependencies": {
    "@sentry/react": "^10.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "adm-zip": "^0.5.17",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
